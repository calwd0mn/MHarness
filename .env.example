# DeepSeek 7.3 验收配置。复制为 .env 后在本机填写 API Key。
MHARNESS_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
MHARNESS_MODEL_NAME=deepseek-v4-pro
MHarness_BASE_URL=https://api.deepseek.com
MHARNESS_MODEL_MAX_TOKENS=64
MHARNESS_MODEL_REASONING_EFFORT=none
MHARNESS_SESSION_DB_PATH=data/mharness-deepseek-7.3.sqlite
